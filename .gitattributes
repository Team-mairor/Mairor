# 훅 스크립트는 Windows에서도 LF 유지 (CRLF면 sh가 실행 못 함)
.githooks/** text eol=lf
*.sh text eol=lf

# frontend: Prettier 기준 LF
frontend/** text=auto eol=lf

*.task binary
*.onnx binary
*.woff2 binary

# AI 학습 모델 파일은 Git LFS에 둔다 (받으려면 PC마다 한 번 git lfs install --skip-repo)
ai/app/weights/*.onnx filter=lfs diff=lfs merge=lfs -text

# Gradle wrapper 스크립트도 LF (Windows에서 bash gradlew 실행)
gradlew text eol=lf
*.bat text eol=crlf
