# SSAFY 엔터프라이즈 GMS API Key
GMS_API_KEY=your_ssafy_gms_api_key_here

# AWS S3 인증 정보
AWS_REGION=ap-northeast-2
S3_BUCKET=your_s3_bucket_name_here
# --serve(BE 연결 모드)는 이 운영 버킷에 올린다. BE가 여기서 요청 JSON을 읽는다
S3_PROD_BUCKET=mairor-prod-media
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# BE 노트북 API (python pipeline.py --serve). 토큰은 Parameter Store /mairor/prod/PROCESSOR_API_TOKEN 값
PROCESSOR_API_URL=https://mairor.co.kr/api/v1/internal/processor
PROCESSOR_API_TOKEN=your_processor_api_token_here
