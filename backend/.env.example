# application.yml 의 spring.config.import 가 이 파일을 읽는다. 값에 따옴표를 쓰지 않는다.
# 프로파일은 기본 dev. 운영은 환경변수 SPRING_PROFILES_ACTIVE=prod 로 켠다.
# 여기 없는 설정(요청 제한, 약관 버전, 메일 서버 주소 등)은 기본값을 쓴다. 바꾸려면 README 환경변수 표를 본다.

DB_URL=jdbc:postgresql://localhost:5432/mairor
DB_USERNAME=mairor
DB_PASSWORD=change-me

# 회원가입·로그인 요청을 보낼 수 있는 프론트 Origin (쉼표 구분, 스킴://호스트[:포트]). dev 는 비워 두면 localhost:3000(프론트)과 localhost:8080(Swagger UI)을 쓴다.
# 직접 적으면 기본값을 대체한다. 폰 테스트: ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000,http://localhost:8080,https://192.168.0.10:3000
# 운영(prod)은 반드시 설정해야 한다. 비어 있으면 앱이 기동하지 않는다.
#ALLOWED_ORIGINS=

# 가입 이메일 인증번호 메일 (Gmail SMTP). 실제 메일은 MAIL_ENABLED=true 일 때만 보낸다.
# false(기본)면 dev 에서는 인증번호를 서버 로그로만 남기고, prod 에서는 발송이 항상 실패한다.
# Gmail 은 2단계 인증을 켠 프로젝트 전용 계정의 "앱 비밀번호"(16자리)를 쓴다. 계정 비밀번호가 아니다.
#MAIL_ENABLED=true
#MAIL_USERNAME=your-account@gmail.com
#MAIL_PASSWORD=앱비밀번호16자리

# true 면 가입에 이메일 인증 토큰이 필요하다 (기본 false). prod 에서 켜면 위 MAIL_* 와 아래 비밀키가 없을 때 기동 실패한다.
#SIGNUP_REQUIRE_EMAIL_VERIFICATION=false
# 인증번호 해시용 비밀키(임의의 긴 문자열). 비우면 서버를 켤 때마다 바뀌어 재시작 시 진행 중인 인증이 무효가 된다.
#EMAIL_VERIFICATION_SECRET=

# Google 로그인 (GCP OAuth 클라이언트, 웹 애플리케이션). 셋을 모두 넣거나 모두 비운다. 비우면 Google 로그인만 503 이다(prod 는 기동 실패).
# 리디렉션 URI 는 GCP 에 등록한 값과 같아야 하고, BE(:8080)가 아니라 FE 주소의 /api 경로다.
#GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=
#GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/users/oauth/google/callback

# 내부 API(운영자 분석 명령·AI 콜백) 공유 토큰. 비우면 내부 API 는 모두 401. 로컬은 아무 긴 값이나 넣는다
#INTERNAL_API_TOKEN=

# 분석 worker 로컬 실행: 저장소 폴더(키가 이 아래 상대 경로), ffprobe 위치
#APP_STORAGE_LOCAL_ROOT=C:/mairor-storage
#FFPROBE_PATH=ffprobe
