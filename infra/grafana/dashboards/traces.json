      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(histogram_quantile(0.95, sum by (le, step) (label_replace(increase(traces_spanmetrics_latency_bucket{service=\"ai\", span_name!=\"guide_job\"}[$__range]), \"step\", \"$1\", \"span_name\", \"([^ ]+).*\"))))",
          "refId": "A",
          "legendFormat": "{{step}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
