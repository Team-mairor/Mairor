          },
          "expr": "100 * (sum(increase(traces_spanmetrics_calls_total{service=\"ai\", span_name=\"guide_job\", status_code=\"STATUS_CODE_ERROR\"}[$__range])) or vector(0)) / sum(increase(traces_spanmetrics_calls_total{service=\"ai\", span_name=\"guide_job\"}[$__range]))",
