# 인프라 서버의 유일한 공개 입구(80 · 443). 인증서는 Let's Encrypt 에서 자동으로 받는다.
# 앱 서버 Alloy 가 보내는 주소와 phoenix 는 앱 서버 Elastic IP 에서 온 요청만 받는다. 나머지는 Grafana 로 넘기고 Grafana 로그인이 막는다.
# INFRA_DOMAIN 은 서버 .env 에서 온다(infra/README.md).
{$INFRA_DOMAIN} {
	@outsider {
		path /loki/api/v1/push /api/v1/write /v1/traces /phoenix/*
		not remote_ip 54.117.21.39
	}

	# handle 은 경로가 구체적인 것부터 돌아서 막는 줄이 뒤로 밀린다. route 로 적은 순서를 지킨다
	route {
		respond @outsider 403

		handle /loki/api/v1/push {
			reverse_proxy loki:3100
		}
		handle /api/v1/write {
			reverse_proxy prometheus:9090
		}
		handle /v1/traces {
			reverse_proxy tempo:4318
		}
		handle_path /phoenix/* {
			reverse_proxy phoenix:6006
		}
		handle {
			reverse_proxy grafana:3000
		}
	}
}
