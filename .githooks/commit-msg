#!/bin/sh
# 커밋 메시지가 Commit Convention을 따르는지 검증한다.
#   <type>(<scope>): <subject>
#
#   <footer> <jira-key>
. "$(dirname "$0")/_common.sh"

MSG_FILE=$1

# 주석(#)과 diff 부분을 제거한 실제 메시지
BODY=$(grep -v '^#' "$MSG_FILE" | sed '/^diff --git/,$d')
SUBJECT=$(echo "$BODY" | sed '/^[[:space:]]*$/d' | head -n 1)

# merge / revert / fixup / squash 커밋은 통과
case "$SUBJECT" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

if [ -z "$SUBJECT" ]; then
  err "커밋 메시지가 비어 있습니다."
  exit 1
fi

fail=0

# 1) 전체 형식
if ! echo "$SUBJECT" | grep -Eq "^($TYPES)(\([a-z0-9]+(-[a-z0-9]+)*\))?!?: .+"; then
  err "커밋 메시지 형식이 맞지 않습니다."
  dim ""
  dim "입력한 메시지: $SUBJECT"
  dim ""
  dim "형식  : <type>(<scope>): <subject>"
  dim "예시  : feat(auth): 소셜 로그인 기능 추가"
  dim "type  : feat fix refactor perf test docs build ci chore"
  dim ""

  # 흔한 실수 짚어주기
  if echo "$SUBJECT" | grep -Eq "^($TYPES)(\([^)]*\))?!?:[^ ]"; then
    dim "→ 콜론(:) 뒤에 공백이 필요합니다."
  fi
  if echo "$SUBJECT" | grep -Eq "^($TYPES)\([^)]*[A-Z][^)]*\)"; then
    dim "→ scope는 소문자 기능 ID로 작성합니다. 파일명/클래스명은 금지입니다."
    dim "   O  feat(auth): ...        X  feat(AuthService): ..."
  fi
  if echo "$SUBJECT" | grep -Eq '^[A-Z]+(\([^)]*\))?!?:'; then
    dim "→ type은 소문자로 작성합니다. (FEAT: → feat:)"
  fi
  fail=1
fi

# 2) subject 끝 마침표 금지
if echo "$SUBJECT" | grep -q '\.[[:space:]]*$'; then
  err "subject 끝에 마침표를 쓰지 않습니다."
  dim "입력한 메시지: $SUBJECT"
  fail=1
fi

# 3) 너무 모호한 subject 차단 (컨벤션 '지양' 예시)
TEXT=$(echo "$SUBJECT" | sed -E "s/^($TYPES)(\([^)]*\))?!?: //")
case "$TEXT" in
  수정|추가|삭제|변경|기능\ 추가|버그\ 수정|코드\ 변경|코드\ 수정|리팩토링|오류\ 수정)
    err "subject가 너무 모호합니다: \"$TEXT\""
    dim "무엇을 어떻게 바꿨는지 쓰세요."
    dim "  X  fix: 수정"
    dim "  O  fix(room): 재접속 시 중복 입장 문제 수정"
    fail=1
    ;;
esac

# 4) Jira 키는 footer에 "Refs: <KEY>" 형태로 필수
#    subject에 넣는 것은 금지 (팀 규칙)
if echo "$SUBJECT" | grep -Eq "$JIRA_KEY"; then
  err "subject에는 Jira 키를 넣지 않습니다. footer에 적어주세요."
  dim ""
  dim "  X  feat(auth): $JIRA_PROJECT-123 소셜 로그인 추가"
  dim ""
  dim "  O  feat(auth): 소셜 로그인 추가"
  dim "     (빈 줄)"
  dim "     Refs: $JIRA_PROJECT-123"
  fail=1
fi

if ! echo "$BODY" | grep -Eq "^Refs: $JIRA_KEY"; then
  err "footer에 Jira 이슈 키가 없습니다."
  dim ""
  dim "subject 다음에 빈 줄을 두고 아래 형식으로 적어주세요:"
  dim "  Refs: $JIRA_PROJECT-123"
  dim ""
  dim "전체 예시:"
  dim "  feat(auth): 소셜 로그인 기능 추가"
  dim ""
  dim "  Refs: $JIRA_PROJECT-123"
  dim ""
  dim "브랜치명이 컨벤션($JIRA_PROJECT-<번호> 포함)을 따르면"
  dim "prepare-commit-msg 훅이 자동으로 넣어줍니다."
  fail=1
else
  # subject 바로 다음 줄에 붙어 있으면 빈 줄을 요구한다
  if echo "$BODY" | sed -n '2p' | grep -Eq "^Refs: "; then
    err "subject와 footer 사이에는 빈 줄이 있어야 합니다."
    fail=1
  fi
fi

# 5) 경고 (차단하지 않음)
if [ "${#TEXT}" -gt 60 ]; then
  warn "subject가 깁니다 (${#TEXT}자). 한 줄로 짧게 요약하는 것을 권장합니다."
fi

[ "$fail" -eq 0 ] || { dim ""; dim "수정하려면: git commit --edit 또는 다시 커밋"; exit 1; }
exit 0
