#!/bin/sh
# 새 브랜치를 만들면 원격 브랜치를 자동으로 생성하고 추적까지 걸어준다.
# 원격에 브랜치가 생겨야 Jira 자동화가 이슈를 '진행 중'으로 옮긴다.
#
# 인자: $1=이전 HEAD  $2=새 HEAD  $3=1이면 브랜치 체크아웃, 0이면 파일 체크아웃
#
# 아래 경우에는 아무것도 하지 않는다 (네트워크 요청 없음):
#   - 파일 체크아웃
#   - 보호 브랜치(master/main/develop)
#   - 이미 업스트림이 설정된 브랜치
#   - origin/<브랜치>가 이미 로컬에 있는 경우 (= 기존 브랜치로 전환)
. "$(dirname "$0")/_common.sh"

[ "$3" = "1" ] || exit 0

BRANCH=$(git symbolic-ref --short -q HEAD) || exit 0
is_protected "$BRANCH" && exit 0

# 이미 추적 중이면 끝
git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1 && exit 0

# origin/<브랜치>가 로컬에 이미 있으면 네트워크 없이 추적만 연결
if git rev-parse --verify --quiet "refs/remotes/origin/$BRANCH" >/dev/null; then
  git branch --set-upstream-to="origin/$BRANCH" "$BRANCH" >/dev/null 2>&1 \
    && dim "origin/$BRANCH 추적 연결됨"
  exit 0
fi

# origin 자체가 없으면 (로컬 전용 레포) 끝
git remote get-url origin >/dev/null 2>&1 || exit 0

# 브랜치명이 컨벤션에 맞지 않으면 push 하지 않는다
if ! check_branch_name "$BRANCH"; then
  err "브랜치 이름이 컨벤션에 맞지 않아 원격에 올리지 않았습니다: $BRANCH"
  print_branch_rule
  dim ""
  dim "이름 변경: git branch -m <새이름>"
  exit 0
fi

dim "원격 브랜치 생성 중... ($BRANCH)"
if git push --quiet --set-upstream origin "$BRANCH" >/dev/null 2>&1; then
  ok "origin/$BRANCH 생성 완료 (추적 설정됨)"
else
  warn "원격 브랜치 생성에 실패했습니다. (오프라인이거나 권한 문제일 수 있습니다)"
  dim "나중에 직접: git push -u origin $BRANCH"
fi
exit 0
