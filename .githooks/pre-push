#!/bin/sh
# push 직전 검증
#   - master/main 직접 push 차단 (모든 변경은 Merge Request 경유)
#   - 브랜치 이름이 컨벤션을 따르는지 검증
#
# stdin: <local ref> <local sha> <remote ref> <remote sha>
. "$(dirname "$0")/_common.sh"

ZERO=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue

  # 브랜치 삭제(push --delete)는 통과
  [ "$local_sha" = "$ZERO" ] && continue

  branch=${remote_ref#refs/heads/}

  if is_protected "$branch"; then
    err "$branch 브랜치에는 직접 push할 수 없습니다."
    dim "모든 변경은 Merge Request를 통해 반영합니다."
    dim ""
    dim "작업 브랜치를 만들어 옮기세요:"
    dim "  git switch -c feat/<description>-<jira-key>"
    fail=1
    continue
  fi

  if ! check_branch_name "$branch"; then
    err "브랜치 이름이 컨벤션에 맞지 않습니다: $branch"
    print_branch_rule
    dim ""
    dim "이름 변경: git branch -m <새이름>"
    fail=1
  fi
done

[ "$fail" -eq 0 ] || exit 1
exit 0
