{
  "$defs": {
    "Color": {
      "description": "색 칸 하나. 색을 못 구했으면 hex·colorSource·colorQuality는 null이고 칸만 남긴다.",
      "properties": {
        "sortOrder": {
          "minimum": 1,
          "title": "Sortorder",
          "type": "integer"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "nameSource": {
          "$ref": "#/$defs/NameSource"
        },
        "hex": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hex"
        },
        "colorSource": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shadeLink": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShadeLink"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "colorQuality": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Colorquality"
        },
        "evidenceKey": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Evidencekey",
          "type": "string"
        }
      },
      "required": [
        "sortOrder",
        "nameSource",
        "evidenceKey"
      ],
      "title": "Color",
      "type": "object"
    },
    "ColorSource": {
      "enum": [
        "SOURCE_VALUE",
        "SWATCH_CHIP",
        "PRODUCT_PHOTO",
        "WEB_PHOTO",
        "LLM_ESTIMATE"
      ],
      "title": "ColorSource",
      "type": "string"
    },
    "ColorStatus": {
      "enum": [
        "EXTRACTED",
        "NOT_FOUND",
        "FAILED"
      ],
      "title": "ColorStatus",
      "type": "string"
    },
    "NameSource": {
      "enum": [
        "SITE_TEXT",
        "IMAGE_PRINT",
        "NONE"
      ],
      "title": "NameSource",
      "type": "string"
    },
    "SaleStatus": {
      "enum": [
        "ON_SALE",
        "SOLD_OUT",
        "MISSING"
      ],
      "title": "SaleStatus",
      "type": "string"
    },
    "Shade": {
      "description": "호수 하나. 옵션 원문을 합치지 않고 그대로 보낸다.",
      "properties": {
        "sourceOptionId": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Sourceoptionid",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sortOrder": {
          "minimum": 0,
          "title": "Sortorder",
          "type": "integer"
        },
        "slotOrderBasis": {
          "anyOf": [
            {
              "$ref": "#/$defs/SlotOrderBasis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "colorStatus": {
          "$ref": "#/$defs/ColorStatus"
        },
        "variantHints": {
          "anyOf": [
            {
              "$ref": "#/$defs/VariantHints"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "colors": {
          "items": {
            "$ref": "#/$defs/Color"
          },
          "maxItems": 30,
          "title": "Colors",
          "type": "array"
        }
      },
      "required": [
        "sourceOptionId",
        "name",
        "sortOrder",
        "colorStatus"
      ],
      "title": "Shade",
      "type": "object"
    },
    "ShadeLink": {
      "enum": [
        "OPTION_IMAGE",
        "SINGLE_SHADE_PRODUCT",
        "LABEL_IN_IMAGE",
        "UNVERIFIED"
      ],
      "title": "ShadeLink",
      "type": "string"
    },
    "SlotOrderBasis": {
      "enum": [
        "GRID",
        "UNKNOWN"
      ],
      "title": "SlotOrderBasis",
      "type": "string"
    },
    "VariantHints": {
      "description": "같은 호수를 합칠지 판단하는 구분 정보. 값은 사이트 원문이고, 사이트에 없으면 null이다.\n\n이 객체 자체를 보내지 않으면 '수집하지 않음'이라 백엔드가 자동으로 합치지 않는다.",
      "properties": {
        "volume": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume"
        },
        "composition": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Composition"
        },
        "formulation": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formulation"
        },
        "optionAttributes": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "maxProperties": 20,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Optionattributes"
        },
        "listPrice": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Listprice"
        }
      },
      "title": "VariantHints",
      "type": "object"
    }
  },
  "description": "수집한 상품 한 건. 백엔드 적재로 가는 값이다.",
  "properties": {
    "contractVersion": {
      "const": 1,
      "default": 1,
      "title": "Contractversion",
      "type": "integer"
    },
    "itemKey": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Itemkey",
      "type": "string"
    },
    "source": {
      "maxLength": 100,
      "pattern": "^(OFFICIAL|WEB):[A-Za-z0-9.-]+$",
      "title": "Source",
      "type": "string"
    },
    "sourceProductId": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Sourceproductid",
      "type": "string"
    },
    "sourceUrl": {
      "maxLength": 1000,
      "pattern": "^https?://\\S+$",
      "title": "Sourceurl",
      "type": "string"
    },
    "sourceLanguage": {
      "maxLength": 10,
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$",
      "title": "Sourcelanguage",
      "type": "string"
    },
    "collectedAt": {
      "format": "date-time",
      "title": "Collectedat",
      "type": "string"
    },
    "brand": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Brand",
      "type": "string"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "sourceCategoryPath": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Sourcecategorypath",
      "type": "array"
    },
    "categoryHint": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Categoryhint"
    },
    "typeHint": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Typehint"
    },
    "imageUrl": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Imageurl"
    },
    "saleStatus": {
      "anyOf": [
        {
          "$ref": "#/$defs/SaleStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "shades": {
      "items": {
        "$ref": "#/$defs/Shade"
      },
      "maxItems": 200,
      "title": "Shades",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "contractVersion",
    "itemKey",
    "source",
    "sourceProductId",
    "sourceUrl",
    "sourceLanguage",
    "collectedAt",
    "brand",
    "name"
  ],
  "title": "CollectedProduct",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collected_product.v1.schema.json"
}
