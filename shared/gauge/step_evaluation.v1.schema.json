{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StepEvaluationSpec",
  "description": "단계 끝 AI 평가(덮음 · 넘침 · 진하기) 규칙의 값과 기대값 시험 데이터. ai/tools/gauge/export_step_evaluation_spec.py가 만든다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "grid", "sides", "directions", "paint", "band", "combine", "coveredMax", "drift", "minAreaCells", "minSideCells", "thresholds", "skin", "cases"],
  "properties": {
    "version": { "const": "v1" },
    "grid": { "type": "integer", "minimum": 1, "description": "얼굴 지도 칸 수(가로 · 세로)" },
    "sides": { "type": "array", "items": { "$ref": "#/$defs/side" }, "description": "방향 순서" },
    "directions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/lab" },
      "description": "레퍼런스 효과가 없을 때 쓰는 화장 종류별 기본 화장 방향(Lab, 길이 1로 맞춰 씀)"
    },
    "paint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["floor", "share", "deltaFallback"],
      "properties": {
        "floor": { "type": "number", "exclusiveMinimum": 0, "description": "바른 칸 문턱(Lab 길이)의 가장 작은 값" },
        "share": { "type": "number", "minimum": 0, "description": "문턱 = max(floor, share × 레퍼런스 효과 Lab 길이)" },
        "deltaFallback": { "type": "number", "exclusiveMinimum": 0, "description": "방향을 모르는 화장 종류는 ΔE2000이 이 값 이상인 칸" }
      }
    },
    "band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "gap", "sideMethod"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "description": "둘레 띠 두께(칸)" },
        "gap": { "type": "integer", "minimum": 0, "description": "영역과 둘레 띠 사이 띄우는 칸" },
        "sideMethod": { "enum": ["edge", "center"], "description": "둘레 띠 칸 방향을 정하는 법" }
      }
    },
    "combine": { "enum": ["weaker", "pooled", "mean"], "description": "좌우 묶음 합치기. weaker는 덮음은 적은 쪽, 넘침은 많은 쪽" },
    "coveredMax": { "type": "number", "minimum": 0, "maximum": 1, "description": "영역 칸 중 색이 없는 칸 몫이 이보다 크면 covered" },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratioMax", "allMax"],
      "properties": {
        "ratioMax": { "type": "number", "exclusiveMinimum": 0, "description": "맨피부 변화(ΔE2000)가 이보다 크면 진하기만 뺌" },
        "allMax": { "type": "number", "exclusiveMinimum": 0, "description": "맨피부 변화가 이보다 크면 평가하지 않음(lightChanged)" }
      }
    },
    "minAreaCells": { "type": "integer", "minimum": 1 },
    "minSideCells": { "type": "integer", "minimum": 1, "description": "한 방향 칸이 이보다 적으면 그 방향 값은 null" },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverageLow", "sideCoverageLow", "sideOverflowHigh"],
      "description": "안내 문장 규칙이 처음 쓸 기준값(설정 자동 탐색으로 다시 고름)",
      "properties": {
        "coverageLow": { "type": "number", "minimum": 0, "maximum": 1, "description": "덮음이 이보다 작으면 덜 바름" },
        "sideCoverageLow": { "type": "number", "minimum": 0, "maximum": 1, "description": "그 방향 덮음이 이보다 작으면 그쪽이 빔" },
        "sideOverflowHigh": { "type": "number", "minimum": 0, "maximum": 1, "description": "그 방향 넘침이 이 이상이면 그쪽으로 넘침" }
      }
    },
    "skin": { "$ref": "#/$defs/lab", "description": "시험 데이터의 단계 시작 칸 색(재는 칸 모두 같음)" },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "side": { "enum": ["up", "down", "inner", "outer"] },
    "lab": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "runs": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 3, "maxItems": 3 },
      "description": "[행, 시작 열, 끝 열(포함)] 줄 목록"
    },
    "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "sideScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "overflow"],
      "properties": { "coverage": { "$ref": "#/$defs/score" }, "overflow": { "$ref": "#/$defs/score" } }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "makeup", "areas", "paint", "expected"],
      "properties": {
        "name": { "type": "string" },
        "makeup": { "type": "string" },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lab", "delta", "white"],
          "properties": { "lab": { "$ref": "#/$defs/lab" }, "delta": { "$ref": "#/$defs/lab" }, "white": { "type": "string" } },
          "description": "가이드 결과 gauge의 color.lab · effect.delta · white.hex"
        },
        "userWhite": { "type": "string", "description": "맨얼굴 기준 흰자 색(#RRGGBB)" },
        "light": { "$ref": "#/$defs/lab", "description": "끝 칸 색 모두에 더한 조명 변화(Lab)" },
        "areas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["region", "cells"],
            "properties": { "region": { "type": "string" }, "cells": { "$ref": "#/$defs/runs" } }
          }
        },
        "paint": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cells", "delta"],
            "properties": { "cells": { "$ref": "#/$defs/runs" }, "delta": { "$ref": "#/$defs/lab" } }
          }
        },
        "covered": { "$ref": "#/$defs/runs", "description": "끝 칸 색에서 비운(가린) 칸" },
        "noStart": { "type": "boolean", "description": "단계 시작 칸 색이 없음" },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coverage", "overflow", "sides", "ratio", "ratioReason", "reason", "drift", "regions"],
          "properties": {
            "coverage": { "$ref": "#/$defs/score" },
            "overflow": { "$ref": "#/$defs/score" },
            "sides": {
              "type": "object",
              "additionalProperties": false,
              "required": ["up", "down", "inner", "outer"],
              "properties": {
                "up": { "$ref": "#/$defs/sideScore" },
                "down": { "$ref": "#/$defs/sideScore" },
                "inner": { "$ref": "#/$defs/sideScore" },
                "outer": { "$ref": "#/$defs/sideScore" }
              }
            },
            "ratio": { "type": ["number", "null"], "minimum": 0 },
            "ratioReason": { "type": ["string", "null"] },
            "reason": { "enum": [null, "noStart", "noEnd", "noArea", "thinArea", "tooFewCells", "covered", "lightChanged"] },
            "drift": { "type": ["number", "null"], "minimum": 0 },
            "regions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["region", "coverage", "overflow", "cells", "band", "reason"],
                "properties": {
                  "region": { "type": ["string", "null"] },
                  "coverage": { "$ref": "#/$defs/score" },
                  "overflow": { "$ref": "#/$defs/score" },
                  "cells": { "type": "integer", "minimum": 0 },
                  "band": { "type": "integer", "minimum": 0 },
                  "reason": { "enum": [null, "tooFewCells", "covered"] }
                }
              }
            }
          }
        }
      }
    }
  }
}
