{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AreaStep": {
      "description": "가이드 입력의 단계 하나. stepId · order · makeup은 가이드 입력 그대로다.",
      "properties": {
        "stepId": {
          "minLength": 1,
          "title": "Stepid",
          "type": "string"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "makeup": {
          "enum": [
            "foundation",
            "eyeshadow",
            "eyeliner",
            "blush",
            "lip",
            "brow",
            "mascara",
            "contour",
            "highlight",
            "other"
          ],
          "title": "Makeup",
          "type": "string"
        },
        "subSteps": {
          "items": {
            "$ref": "#/$defs/AreaSubStep"
          },
          "minItems": 1,
          "title": "Substeps",
          "type": "array"
        }
      },
      "required": [
        "stepId",
        "order",
        "makeup",
        "subSteps"
      ],
      "title": "AreaStep",
      "type": "object"
    },
    "AreaSubStep": {
      "description": "하위 단계. status에 따라 guideSets · templateId · reasons를 채우는 규칙이 정해져 있다.\n\nextracted: 영역 1개 이상 / template: 영역 없이 templateId와 이유 / notApplicable: 모두 비움 /\nfailed: 영역 없이 이유만\ntemplateId는 FE 기본 가이드 키다. 화장 종류에 더해 아이섀도는 바른 자리별 키\n(eyeshadowUpper 윗눈두덩, eyeshadowUnder 눈 밑)가 있고, eyeshadow는 위아래 모두다.\n아이라인은 그린 자리별 키(eyelinerWaterline 꼬리 없는 윗점막 선, eyelinerUnder 아랫라인)가 있고,\neyeliner는 꼬리까지 그린 윗라인이다.\n블러셔는 코(코끝·콧등·콧대)에 바르는 단계의 키 blushNose가 있고, blush는 두 볼이다.\n쉐딩은 콧대 옆에 바르는 단계의 키 contourNose가 있고, contour는 옆광대에서 턱선까지다.\ngauge는 게이지 기준이다. extracted는 값, 또는 영역은 찾았지만 값을 못 낸 이유이고,\ntemplate은 noArea, notApplicable·failed는 null이다.\n게이지 기준을 넣기 전 결과와 색 뽑기가 실패한 결과에는 없다(null).",
      "properties": {
        "subStepId": {
          "minLength": 1,
          "title": "Substepid",
          "type": "string"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "status": {
          "enum": [
            "extracted",
            "template",
            "notApplicable",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "templateId": {
          "anyOf": [
            {
              "enum": [
                "foundation",
                "eyeshadow",
                "eyeliner",
                "blush",
                "lip",
                "brow",
                "mascara",
                "contour",
                "highlight",
                "other",
                "eyeshadowUpper",
                "eyeshadowUnder",
                "eyelinerWaterline",
                "eyelinerUnder",
                "blushNose",
                "contourNose"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Templateid"
        },
        "guideSets": {
          "items": {
            "$ref": "#/$defs/GuideSet"
          },
          "title": "Guidesets",
          "type": "array"
        },
        "gauge": {
          "anyOf": [
            {
              "$ref": "#/$defs/GaugeReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "subStepId",
        "order",
        "status",
        "reasons",
        "templateId",
        "guideSets"
      ],
      "title": "AreaSubStep",
      "type": "object"
    },
    "ArrowShape": {
      "description": "바르는 방향. from은 먼저 바른 곳(시작점), to는 나중에 바른 곳이고 FE가 from → to로 그린다.\n\nFE 얼굴 구조 스키마(face/types.ts)의 arrow 도형과 같다.",
      "properties": {
        "type": {
          "const": "arrow",
          "title": "Type",
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/MeshAnchor"
        },
        "to": {
          "$ref": "#/$defs/MeshAnchor"
        }
      },
      "required": [
        "type",
        "from",
        "to"
      ],
      "title": "ArrowShape",
      "type": "object"
    },
    "GaugeColor": {
      "description": "색 하나. hex는 sRGB #RRGGBB다.\n\nlab은 같은 sRGB 색을 D65 흰색 기준 CIELAB으로 바꾼 (L 밝기 0~100, a 초록-빨강, b 파랑-노랑)이다.",
      "properties": {
        "hex": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Hex",
          "type": "string"
        },
        "lab": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Lab",
          "type": "array"
        }
      },
      "required": [
        "hex",
        "lab"
      ],
      "title": "GaugeColor",
      "type": "object"
    },
    "GaugeEffect": {
      "description": "화장 효과. 화장이 그 자리 색을 얼마나, 어느 쪽으로 바꿨나다.\n\ndelta는 바른 뒤 색 − 기준 색의 (ΔL, Δa, Δb)다.\n기준 색은 화장이 없었다면 그 자리에 있었을 색으로, 바르기 전 색에서 단계 동안 바뀐 조명을\n덜어 잡는다.\nsize는 두 색의 ΔE2000 거리다.\ndirection은 밝기가 어두워졌으면 darker(쉐딩·눈썹·아이라인), 밝아졌으면 lighter(하이라이트),\n거의 그대로면 same(색만 바뀜)이다.",
      "properties": {
        "delta": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Delta",
          "type": "array"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "number"
        },
        "direction": {
          "enum": [
            "darker",
            "lighter",
            "same"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "delta",
        "size",
        "direction"
      ],
      "title": "GaugeEffect",
      "type": "object"
    },
    "GaugeReference": {
      "description": "하위 단계의 게이지 기준. 레퍼런스 영상에서 바른 자리의 색과 화장 효과·진하기다.\n\n값을 냈으면 color·effect·strength가 모두 있고 reason은 null이다.\n못 냈으면 셋 다 null이고 reason에 이유가 든다.\nnoArea는 찾은 영역이 없음(기본 가이드 단계), noMaps는 쓸 사진이 없음,\ntooFewCells는 색을 낼 칸이 너무 적음, colorSpread는 사진마다 색이 화장으로 바뀐 양보다\n더 흔들려 화장 색인지 알 수 없음, sidesDisagree는 좌우 짝 부위에서 한쪽은 어두워지고\n다른 쪽은 밝아져 적어도 한쪽이 화장 색이 아님, notDarker는 어두워지는 화장(아이라인·눈썹·쉐딩)이\n어두워지지 않아 찾은 칸이 그린 자리가 아님이다.\ncolor는 바른 뒤 색이다. 좌우 짝 부위는 찾은 쪽 칸만 합쳐 낸 색이다.\nstrength는 effect.size를 0~100으로 바꾼 진하기다.\nwhite는 레퍼런스 영상의 흰자 색이다. 사용자 캠과 조명 · 카메라를 맞출 때 쓴다.\n눈 화장 전 정면 · 눈 뜬 사진에서 영상마다 한 번 재서 모든 하위 단계에 같은 값을 넣고,\n못 쟀으면 null이다. 값을 못 낸 기준(reason이 있음)에도 null이다.",
      "properties": {
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/GaugeColor"
            },
            {
              "type": "null"
            }
          ]
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/GaugeEffect"
            },
            {
              "type": "null"
            }
          ]
        },
        "strength": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Strength"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "noArea",
                "noMaps",
                "tooFewCells",
                "colorSpread",
                "sidesDisagree",
                "notDarker"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "white": {
          "anyOf": [
            {
              "$ref": "#/$defs/GaugeColor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "color",
        "effect",
        "strength",
        "reason"
      ],
      "title": "GaugeReference",
      "type": "object"
    },
    "GuideSet": {
      "description": "부위별 묶음. region은 얼굴의 어디·어느 쪽인지, exclude는 이 영역에서 뺄 부위다.\n\nguides에는 도포 영역(polygon)이 1개 이상 있어야 하고, 방향(arrow)은 순서를 알 때만 넣는다.",
      "properties": {
        "region": {
          "enum": [
            "leftEye",
            "rightEye",
            "leftBrow",
            "rightBrow",
            "lipsOuter",
            "lipsInner",
            "leftCheek",
            "rightCheek",
            "faceOval"
          ],
          "title": "Region",
          "type": "string"
        },
        "source": {
          "enum": [
            "extracted",
            "manual"
          ],
          "title": "Source",
          "type": "string"
        },
        "guides": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/PolygonShape"
              },
              {
                "$ref": "#/$defs/ArrowShape"
              }
            ]
          },
          "minItems": 1,
          "title": "Guides",
          "type": "array"
        },
        "exclude": {
          "items": {
            "enum": [
              "leftEye",
              "rightEye",
              "leftBrow",
              "rightBrow",
              "lipsOuter",
              "lipsInner",
              "leftCheek",
              "rightCheek",
              "faceOval"
            ],
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        }
      },
      "required": [
        "region",
        "source",
        "guides"
      ],
      "title": "GuideSet",
      "type": "object"
    },
    "MeshAnchor": {
      "description": "얼굴 주소. FE 얼굴 구조 스키마(face/types.ts)의 MeshAnchor와 같다.\n\ntriangle은 shared/face-mesh/triangles.v1.json의 배열 위치(0~897)다.\nbary는 세 꼭짓점에 대한 비율로 합이 1이고, 삼각형 밖이면 음수가 될 수 있다.",
      "properties": {
        "triangle": {
          "exclusiveMaximum": 898,
          "minimum": 0,
          "title": "Triangle",
          "type": "integer"
        },
        "bary": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bary",
          "type": "array"
        }
      },
      "required": [
        "triangle",
        "bary"
      ],
      "title": "MeshAnchor",
      "type": "object"
    },
    "PolygonShape": {
      "description": "도포 영역 테두리. outline은 한 바퀴 도는 순서이고 마지막 점은 첫 점으로 이어 닫는다.",
      "properties": {
        "type": {
          "const": "polygon",
          "title": "Type",
          "type": "string"
        },
        "outline": {
          "items": {
            "$ref": "#/$defs/MeshAnchor"
          },
          "minItems": 3,
          "title": "Outline",
          "type": "array"
        }
      },
      "required": [
        "type",
        "outline"
      ],
      "title": "PolygonShape",
      "type": "object"
    }
  },
  "description": "영상 하나의 단계별 도포 영역. 형식 설명은 shared/guide-area/README.md.",
  "properties": {
    "videoId": {
      "minLength": 1,
      "title": "Videoid",
      "type": "string"
    },
    "meshVersion": {
      "const": "v1",
      "title": "Meshversion",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/AreaStep"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "videoId",
    "meshVersion",
    "steps"
  ],
  "title": "GuideArea",
  "type": "object"
}
