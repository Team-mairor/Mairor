{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AreaStep": {
      "description": "가이드 입력의 단계 하나. stepId · order · makeup은 가이드 입력 그대로다.",
      "properties": {
        "stepId": {
          "minLength": 1,
          "title": "Stepid",
          "type": "string"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "makeup": {
          "enum": [
            "foundation",
            "eyeshadow",
            "eyeliner",
            "blush",
            "lip",
            "brow",
            "mascara",
            "contour",
            "highlight",
            "other"
          ],
          "title": "Makeup",
          "type": "string"
        },
        "subSteps": {
          "items": {
            "$ref": "#/$defs/AreaSubStep"
          },
          "minItems": 1,
          "title": "Substeps",
          "type": "array"
        }
      },
      "required": [
        "stepId",
        "order",
        "makeup",
        "subSteps"
      ],
      "title": "AreaStep",
      "type": "object"
    },
    "AreaSubStep": {
      "description": "하위 단계. status에 따라 guideSets · templateId · reasons를 채우는 규칙이 정해져 있다.\n\nextracted: 영역 1개 이상 / template: 영역 없이 templateId와 이유 / notApplicable: 모두 비움 /\nfailed: 영역 없이 이유만\ntemplateId는 FE 기본 가이드 키다. 화장 종류에 더해 아이섀도는 바른 자리별 키\n(eyeshadowUpper 윗눈두덩, eyeshadowUnder 눈 밑)가 있고, eyeshadow는 위아래 모두다.\n아이라인은 그린 자리별 키(eyelinerWaterline 꼬리 없는 윗점막 선, eyelinerUnder 아랫라인)가 있고,\neyeliner는 꼬리까지 그린 윗라인이다.\n블러셔는 코(코끝·콧등·콧대)에 바르는 단계의 키 blushNose가 있고, blush는 두 볼이다.\n쉐딩은 콧대 옆에 바르는 단계의 키 contourNose가 있고, contour는 옆광대에서 턱선까지다.",
      "properties": {
        "subStepId": {
          "minLength": 1,
          "title": "Substepid",
          "type": "string"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "status": {
          "enum": [
            "extracted",
            "template",
            "notApplicable",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "templateId": {
          "anyOf": [
            {
              "enum": [
                "foundation",
                "eyeshadow",
                "eyeliner",
                "blush",
                "lip",
                "brow",
                "mascara",
                "contour",
                "highlight",
                "other",
                "eyeshadowUpper",
                "eyeshadowUnder",
                "eyelinerWaterline",
                "eyelinerUnder",
                "blushNose",
                "contourNose"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Templateid"
        },
        "guideSets": {
          "items": {
            "$ref": "#/$defs/GuideSet"
          },
          "title": "Guidesets",
          "type": "array"
        }
      },
      "required": [
        "subStepId",
        "order",
        "status",
        "reasons",
        "templateId",
        "guideSets"
      ],
      "title": "AreaSubStep",
      "type": "object"
    },
    "ArrowShape": {
      "description": "바르는 방향. from은 먼저 바른 곳(시작점), to는 나중에 바른 곳이고 FE가 from → to로 그린다.\n\nFE 얼굴 구조 스키마(face/types.ts)의 arrow 도형과 같다.",
      "properties": {
        "type": {
          "const": "arrow",
          "title": "Type",
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/MeshAnchor"
        },
        "to": {
          "$ref": "#/$defs/MeshAnchor"
        }
      },
      "required": [
        "type",
        "from",
        "to"
      ],
      "title": "ArrowShape",
      "type": "object"
    },
    "GuideSet": {
      "description": "부위별 묶음. region은 얼굴의 어디·어느 쪽인지, exclude는 이 영역에서 뺄 부위다.\n\nguides에는 도포 영역(polygon)이 1개 이상 있어야 하고, 방향(arrow)은 순서를 알 때만 넣는다.",
      "properties": {
        "region": {
          "enum": [
            "leftEye",
            "rightEye",
            "leftBrow",
            "rightBrow",
            "lipsOuter",
            "lipsInner",
            "leftCheek",
            "rightCheek",
            "faceOval"
          ],
          "title": "Region",
          "type": "string"
        },
        "source": {
          "enum": [
            "extracted",
            "manual"
          ],
          "title": "Source",
          "type": "string"
        },
        "guides": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/PolygonShape"
              },
              {
                "$ref": "#/$defs/ArrowShape"
              }
            ]
          },
          "minItems": 1,
          "title": "Guides",
          "type": "array"
        },
        "exclude": {
          "items": {
            "enum": [
              "leftEye",
              "rightEye",
              "leftBrow",
              "rightBrow",
              "lipsOuter",
              "lipsInner",
              "leftCheek",
              "rightCheek",
              "faceOval"
            ],
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        }
      },
      "required": [
        "region",
        "source",
        "guides"
      ],
      "title": "GuideSet",
      "type": "object"
    },
    "MeshAnchor": {
      "description": "얼굴 주소. FE 얼굴 구조 스키마(face/types.ts)의 MeshAnchor와 같다.\n\ntriangle은 shared/face-mesh/triangles.v1.json의 배열 위치(0~897)다.\nbary는 세 꼭짓점에 대한 비율로 합이 1이고, 삼각형 밖이면 음수가 될 수 있다.",
      "properties": {
        "triangle": {
          "exclusiveMaximum": 898,
          "minimum": 0,
          "title": "Triangle",
          "type": "integer"
        },
        "bary": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bary",
          "type": "array"
        }
      },
      "required": [
        "triangle",
        "bary"
      ],
      "title": "MeshAnchor",
      "type": "object"
    },
    "PolygonShape": {
      "description": "도포 영역 테두리. outline은 한 바퀴 도는 순서이고 마지막 점은 첫 점으로 이어 닫는다.",
      "properties": {
        "type": {
          "const": "polygon",
          "title": "Type",
          "type": "string"
        },
        "outline": {
          "items": {
            "$ref": "#/$defs/MeshAnchor"
          },
          "minItems": 3,
          "title": "Outline",
          "type": "array"
        }
      },
      "required": [
        "type",
        "outline"
      ],
      "title": "PolygonShape",
      "type": "object"
    }
  },
  "description": "영상 하나의 단계별 도포 영역. 형식 설명은 shared/guide-area/README.md.",
  "properties": {
    "videoId": {
      "minLength": 1,
      "title": "Videoid",
      "type": "string"
    },
    "meshVersion": {
      "const": "v1",
      "title": "Meshversion",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/AreaStep"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "videoId",
    "meshVersion",
    "steps"
  ],
  "title": "GuideArea",
  "type": "object"
}
