# NEXT_PUBLIC_* 값은 브라우저 코드에 포함되므로 비밀값을 넣지 않는다.

NEXT_PUBLIC_API_BASE_URL=/api

# 모의 응답: success | error. 비우면 실제 BE를 호출한다. 운영 빌드(npm run build)에서는 무시된다.
NEXT_PUBLIC_API_MOCK=

# 가입 전 이메일 인증. BE SIGNUP_REQUIRE_EMAIL_VERIFICATION과 맞춘다. BE 메일 발송이 꺼져 있으면(MAIL_ENABLED=false) false
NEXT_PUBLIC_SIGNUP_EMAIL_VERIFICATION=false

# 확인 화면(/debug)·DevNav. 비우면 개발 서버에서만 켜진다. 1이면 빌드에도 넣고, 0이면 개발 서버에서도 끈다.
DEV_TOOLS=

# 개발 서버(npm run dev)에서 /api를 넘길 BE 주소. 예: http://localhost:8080
API_PROXY_TARGET=
