APP_ENV=local
LOG_LEVEL=INFO
# 서버는 json (Loki가 칸별로 읽음)
LOG_FORMAT=text
# tools/gemini_video_test.py 전용 (서버는 읽지 않음)
GEMINI_API_KEY=
# Claude 호출(app/clients/llm.py)과 tools/explain_image_compare.py가 씀
GMS_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=high
LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.anthropic.com
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=50
# 가이드 생성 결과 콜백 (POST /api/v1/guide-jobs)
CALLBACK_TIMEOUT_SECONDS=10
CALLBACK_MAX_RETRIES=3
CALLBACK_RETRY_DELAY_SECONDS=1
# 작업·Claude 호출 기록을 보낼 Phoenix 주소. 비우면 보내지 않음 (로컬: http://localhost:6006/v1/traces)
TRACING_ENDPOINT=
TRACING_PROJECT=ai-guide
