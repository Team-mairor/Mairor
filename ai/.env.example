APP_ENV=local
LOG_LEVEL=INFO
# 서버는 json (Loki가 칸별로 읽음)
LOG_FORMAT=text
# tools/gemini_video_test.py 전용 (서버는 읽지 않음)
GEMINI_API_KEY=
# Claude 호출(app/clients/llm.py)과 tools/explain_image_compare.py가 씀
GMS_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=high
LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.anthropic.com
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=50
# 가이드 생성 결과 콜백 (POST /api/v1/guide-jobs)
CALLBACK_TIMEOUT_SECONDS=10
CALLBACK_MAX_RETRIES=3
CALLBACK_RETRY_DELAY_SECONDS=1
# 진행 알림 (요청에 progressUrl이 있을 때). 바뀐 숫자를 이 간격마다 한 번, 재시도 없이 보냄
PROGRESS_INTERVAL_SECONDS=1
PROGRESS_TIMEOUT_SECONDS=3
# 가이드 영역용 레퍼런스 사진 받기 (요청에 frames가 있을 때)
FRAME_DOWNLOAD_CONCURRENCY=16
FRAME_DOWNLOAD_TIMEOUT_SECONDS=30
FRAME_DOWNLOAD_MAX_RETRIES=1
# 가이드 영역은 CPU를 많이 써서 동시에 이 수만큼만 만든다. 받은 사진은 작업이 끝나면 지운다
AREA_MAX_CONCURRENCY=1
# 사진을 받아 둘 폴더. 줄이 없으면 시스템 임시 폴더 안의 ai-area
# 서버가 뜰 때 이 폴더에 남은 area-* 폴더를 지우므로, 서버 여러 대가 같은 폴더를 쓰면 안 된다
# AREA_WORK_DIR=/data/area
# 작업·Claude 호출 기록을 보낼 Phoenix 주소. 비우면 보내지 않음 (로컬: http://localhost:6006/v1/traces)
TRACING_ENDPOINT=
TRACING_PROJECT=ai-guide

# 화장품 수집기(tools/collect_catalog.py). 요청마다 User-Agent에 실려 사이트 서버 로그에 남는다
CATALOG_CONTACT=
# 화장품 수집기 모델(사진 분류·이름 추정·새 브랜드 홈 검색)
CATALOG_LLM_MODEL=claude-sonnet-4-6
CATALOG_LLM_EFFORT=low
